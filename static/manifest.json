{
  "manifest_version": 3,
  "name": "Lacuna",
  "version": "0.1.0",
  "description": "Redacts sensitive data from prompts sent to web LLM chats and restores it on screen.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lacuna",
    "default_icon": {
      "16": "lacuna_logo.png",
      "32": "lacuna_logo.png",
      "48": "lacuna_logo.png",
      "128": "lacuna_logo.png"
    }
  },
  "icons": {
    "16": "lacuna_logo.png",
    "32": "lacuna_logo.png",
    "48": "lacuna_logo.png",
    "128": "lacuna_logo.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "guard-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "guard-content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "docframe.html",
        "docframe-boot.js",
        "docframe.js",
        "pdf.worker.min.mjs",
        "standard_fonts/*",
        "cmaps/*",
        "wasm/*"
      ],
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*"
      ]
    }
  ],
  "commands": {
    "toggle-screen-guard": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Toggle the screen-share guard"
    }
  }
}
